FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0.001 0 0);  // Initialize with small velocity in x-direction

boundaryField
{
    top
    {
        type            noSlip;
    }
    outlet
    {
        type            zeroGradient;
    }
    back
    {
        type            noSlip;
    }
    solids
    {
        type            noSlip;
    }
}


