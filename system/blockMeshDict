FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Convert from micrometers to meters
convertToMeters 0.000001;

lx0 0;
ly0 0;
lz0 0;

lx1 200;
ly1 200;
lz1 200;

vertices
(
    ($lx0 $ly0 $lz0)   //0
    ($lx1 $ly0 $lz0)   //1
    ($lx1 $ly1 $lz0)   //2
    ($lx0 $ly1 $lz0)   //3
    ($lx0 $ly0 $lz1)   //4
    ($lx1 $ly0 $lz1)   //5
    ($lx1 $ly1 $lz1)   //6
    ($lx0 $ly1 $lz1)   //7
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (100 100 100) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    top
    {
        type wall;    // or patch/symmetryPlane depending on your simulation
        faces
        (
            (7 6 3 2)
        );
    }

    inlet
    {
        type patch;   // Change to patch for flow inlet
        faces
        (
            (0 4 7 3)
        );
    }

    bottom
    {
        type wall;    // or patch/symmetryPlane depending on your simulation
        faces
        (
            (1 5 4 0)
        );
    }

    outlet
    {
        type patch;
        faces
        (
            (1 2 6 5)
        );
    }

    front
    {
        type wall;    // Change from empty to wall or other appropriate type
        faces
        (
            (0 3 2 1)
        );
    }

    back
    {
        type wall;    // Change from empty to wall or other appropriate type
        faces
        (
            (4 5 6 7)
        );
    }
);

