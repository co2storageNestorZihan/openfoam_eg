FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-8;
        relTol          0.1;
        nCellsInCoarsestLevel 2;
    }


    U
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-9;
        relTol          0.1;
        nSweeps         2;
    }

}

SIMPLE
{
    nNonOrthogonalCorrectors 1;
    consistent yes;

    // Reference pressure specification
    pRefCell        0;
    pRefValue       0;

    residualControl
    {
	p		1e-8;
	U		1e-9;
    }
}

potentialFlow
{
    nNonOrthogonalCorrectors 10;
}

relaxationFactors
{
    fields
    {
        p               0.1;
    }
    equations
    {
        U               0.1;
    }
}


