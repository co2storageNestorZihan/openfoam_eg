// Include defaults parameters from master dictionary
//includeEtc "caseDicts/mesh/generation/meshQualityDict"

//- minFaceWeight (0 -> 0.5)
minFaceWeight 0.02;

/* meshQualityDict (local para ESI) */
maxNonOrtho          65;
maxBoundarySkewness  20;
maxInternalSkewness  4;
maxConcave           80;

minVol               1e-13;
minTetQuality        1e-15;

minArea              -1;
minTwist             0.02;

minDeterminant       0.001;
minFaceWeight        0.05;
minVolRatio          0.01;
minTriangleTwist     -1;

nSmoothScale         4;
errorReduction       0.75;
